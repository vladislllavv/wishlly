rules_version = '2';

// Путь данных приложения: artifacts/{appId}/public/data/{wishes|groups|profiles|reservations}
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function validLink(link) {
      return link == '' || link.matches('^https?://.*');
    }

    match /artifacts/{appId}/public/data {

      match /wishes/{wishId} {
        allow read: if signedIn();

        allow create: if isOwner(request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && validLink(request.resource.data.get('link', ''))
          && request.resource.data.get('imageUrl', '').size() < 900000;

        allow delete: if isOwner(resource.data);

        // Владелец меняет свои поля, но не владельца. Кто забронировал — в отдельной
        // коллекции reservations, куда владельцу read закрыт (см. ниже) — это и есть тайная бронь.
        allow update: if isOwner(resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
          && validLink(request.resource.data.get('link', ''));
      }

      // Бронь хранится отдельно от желания и не читается его владельцем ни при каких условиях —
      // даже открыв DevTools, владелец не увидит, что вещь забронирована и уж тем более кем.
      // Документ id == wishId; ownerId продублирован из wishes, чтобы не делать get() в правиле read.
      match /reservations/{wishId} {
        allow read: if signedIn() && resource.data.ownerId != request.auth.uid;

        allow create: if signedIn()
          && request.resource.data.ownerId != request.auth.uid
          && request.resource.data.wishId == wishId
          && request.resource.data.reservedBy == request.auth.uid;

        // Занять свободное или снять свою бронь — больше ничего менять нельзя
        allow update: if signedIn()
          && resource.data.ownerId != request.auth.uid
          && resource.data.ownerId == request.resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedBy', 'updatedAt'])
          && (
            (resource.data.reservedBy == null && request.resource.data.reservedBy == request.auth.uid)
            || (resource.data.reservedBy == request.auth.uid && request.resource.data.reservedBy == null)
          );
      }

      match /groups/{groupId} {
        allow read: if signedIn();
        allow create: if isOwner(request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
        allow update: if isOwner(resource.data) && isOwner(request.resource.data);
        allow delete: if isOwner(resource.data);
      }

      match /profiles/{userId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == userId;
      }

      // Подписка на вишлист друга («Присоединиться»). Id документа: {ownerId}_{friendId}.
      // Создаёт и удаляет только сам friendId; владелец и friendId могут читать свои связи.
      match /friendships/{friendshipId} {
        allow read: if signedIn()
          && (resource.data.friendId == request.auth.uid || resource.data.ownerId == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'friendId', 'createdAt'])
          && request.resource.data.friendId == request.auth.uid
          && request.resource.data.ownerId is string
          && request.resource.data.ownerId != request.auth.uid
          && friendshipId == request.resource.data.ownerId + '_' + request.auth.uid;
        allow delete: if signedIn() && resource.data.friendId == request.auth.uid;
        allow update: if false;
      }

      // Решения like/dislike по идеям подарков (вкладка «Идеи»). Id документа: {uid}_{ideaId}.
      match /giftSwipes/{swipeId} {
        allow read: if signedIn() && resource.data.userId == request.auth.uid;
        allow create, update: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.ideaId is string
          && request.resource.data.liked is bool;
      }
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
