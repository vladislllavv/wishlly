# ============================================================
#  WISHLLY — переменные окружения
#  Скопируйте в .env на сервере (/var/www/wishlly/.env)
# ============================================================

# ---------- СЕРВЕРНЫЕ СЕКРЕТЫ (только server/*, в браузер НЕ попадают) ----------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Любая случайная строка (A-Z, a-z, 0-9, _ и -), до 256 символов.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change_me_random_string

# Публичный URL приложения (открывается кнопкой в боте)
WEBAPP_URL=https://wishlly.ru

# Firebase Admin SDK: Firebase Console → Project settings → Service accounts →
# Generate new private key. Берите поля project_id, client_email, private_key из JSON.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------- ПУБЛИЧНЫЕ (VITE_*, встраиваются в клиентский бандл) ----------
# Firebase Console → Project settings → General → Your apps → Web app config.
# Это не секреты: защита данных обеспечивается Firestore Security Rules.

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Префикс коллекций в Firestore (artifacts/<VITE_APP_ID>/...)
VITE_APP_ID=wishforyou-tma-id

# Username бота без @ (для ссылок «Поделиться»)
VITE_BOT_USERNAME=wishlly_bot
